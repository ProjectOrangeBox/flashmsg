{
    "name": "orange/flashmsg",
    "description": "Flash messaging for traditional (PRG + session) and SPA (JSON response) delivery from one queue.",
    "type": "library",
    "keywords": [
        "flash",
        "flash-messages",
        "notifications",
        "toast",
        "spa"
    ],
    "homepage": "https://github.com/ProjectOrangeBox/flashmsg",
    "license": "MIT",
    "authors": [
        {
            "name": "Don Myers",
            "email": "donmyers@me.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ProjectOrangeBox/flashmsg/issues",
        "source": "https://github.com/ProjectOrangeBox/flashmsg"
    },
    "require": {
        "php": ">=8.4",
        "orange/framework": "dev-master",
        "orange/session": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "orange/testkit": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "orange\\flashmsg\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
